{
  "manifest_version": 3,
  "name": "Better Tabs",
  "version": "0.1.0",
  "description": "A fast, searchable command palette for every open tab in the current window.",
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "permissions": ["tabs", "sessions"],
  "action": {
    "default_title": "Open TabControls",
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png"
    }
  },
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "open-launcher": {
      "suggested_key": { "default": "Alt+Shift+Space", "mac": "Alt+Space" },
      "description": "Open TabControls"
    }
  },
  "browser_specific_settings": { "gecko": { "id": "better-tabs@zen-browser.local" } }
}
